{
  "components": {
    "schemas": {
      "Aggregation": {
        "enum": [
          "vote",
          "single",
          "most_agreeing"
        ],
        "title": "Aggregation",
        "type": "string"
      },
      "Base": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "default": "vote",
            "enum": [
              "vote",
              "sample"
            ],
            "title": "Kind",
            "type": "string"
          },
          "sample": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample"
          }
        },
        "title": "Base",
        "type": "object"
      },
      "Body_upload_audio_v1_audio_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_audio_v1_audio_post",
        "type": "object"
      },
      "Body_upload_chart_v1_charts_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          }
        },
        "required": [
          "file",
          "mode"
        ],
        "title": "Body_upload_chart_v1_charts_post",
        "type": "object"
      },
      "Choice": {
        "additionalProperties": false,
        "description": "One section: its notes are replaced by a sample's notes, or by the caller's own.",
        "properties": {
          "end_ms": {
            "exclusiveMinimum": 0.0,
            "title": "End Ms",
            "type": "number"
          },
          "notes": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Note"
                },
                "maxItems": 20000,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "The charter's finished notes for this section. Generated notes that collide with them give way",
            "title": "Notes"
          },
          "sample": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample"
          },
          "start_ms": {
            "minimum": 0.0,
            "title": "Start Ms",
            "type": "number"
          }
        },
        "required": [
          "start_ms",
          "end_ms"
        ],
        "title": "Choice",
        "type": "object"
      },
      "ContinueRequest": {
        "additionalProperties": false,
        "description": "Keep everything before from_ms and write the rest. The audio is not read again.",
        "properties": {
          "from_ms": {
            "minimum": 0.0,
            "title": "From Ms",
            "type": "number"
          },
          "revision": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Revision to continue from; latest by default",
            "title": "Revision"
          },
          "seed": {
            "default": 1,
            "description": "Change it to get a different continuation",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "from_ms"
        ],
        "title": "ContinueRequest",
        "type": "object"
      },
      "CurvePoint": {
        "additionalProperties": false,
        "properties": {
          "density": {
            "description": "Notes per second",
            "maximum": 60.0,
            "minimum": 0.0,
            "title": "Density",
            "type": "number"
          },
          "end_s": {
            "exclusiveMinimum": 0.0,
            "title": "End S",
            "type": "number"
          },
          "start_s": {
            "minimum": 0.0,
            "title": "Start S",
            "type": "number"
          }
        },
        "required": [
          "start_s",
          "end_s",
          "density"
        ],
        "title": "CurvePoint",
        "type": "object"
      },
      "DraftRequest": {
        "additionalProperties": false,
        "properties": {
          "aggregation": {
            "$ref": "#/components/schemas/Aggregation",
            "default": "vote"
          },
          "artist": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artist"
          },
          "audio_id": {
            "title": "Audio Id",
            "type": "string"
          },
          "density_curve": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CurvePoint"
                },
                "maxItems": 20000,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Replaces the planned curve",
            "title": "Density Curve"
          },
          "level": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 60.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Overall notes per second. Required on Phira.",
            "title": "Level"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "opening_chart_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The charter's chart of at least the opening: style comes from its first 30 s",
            "title": "Opening Chart Id"
          },
          "plan": {
            "default": "balanced",
            "description": "MLX backend only. balanced: 3 parallel rounds, quality matched the frozen setup on 100 songs. fast: 2 rounds, quicker, mania likeness fell clearly. sequential: core by core, the slowest",
            "enum": [
              "balanced",
              "fast",
              "sequential"
            ],
            "title": "Plan",
            "type": "string"
          },
          "profile": {
            "default": "standard",
            "description": "Phira playability limits",
            "enum": [
              "relaxed",
              "standard",
              "expert",
              "none"
            ],
            "title": "Profile",
            "type": "string"
          },
          "samples": {
            "default": 8,
            "description": "Also the number of candidates available per section",
            "maximum": 16.0,
            "minimum": 1.0,
            "title": "Samples",
            "type": "integer"
          },
          "seed": {
            "default": 0,
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "style": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Style"
              },
              {
                "type": "null"
              }
            ]
          },
          "timing": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timing"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "audio_id",
          "mode"
        ],
        "title": "DraftRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Mode": {
        "enum": [
          "phira",
          "mania_4k"
        ],
        "title": "Mode",
        "type": "string"
      },
      "Note": {
        "additionalProperties": false,
        "properties": {
          "end_ms": {
            "minimum": 0.0,
            "title": "End Ms",
            "type": "number"
          },
          "lane": {
            "anyOf": [
              {
                "maximum": 3.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "mania_4k",
            "title": "Lane"
          },
          "time_ms": {
            "minimum": 0.0,
            "title": "Time Ms",
            "type": "number"
          },
          "type": {
            "enum": [
              "tap",
              "hold",
              "flick",
              "drag"
            ],
            "title": "Type",
            "type": "string"
          },
          "x": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Phira position; left out to let the model place it",
            "title": "X"
          }
        },
        "required": [
          "time_ms",
          "end_ms",
          "type"
        ],
        "title": "Note",
        "type": "object"
      },
      "RevisionRequest": {
        "additionalProperties": false,
        "properties": {
          "base": {
            "$ref": "#/components/schemas/Base",
            "default": {
              "kind": "vote"
            }
          },
          "choices": {
            "items": {
              "$ref": "#/components/schemas/Choice"
            },
            "maxItems": 2000,
            "title": "Choices",
            "type": "array"
          }
        },
        "title": "RevisionRequest",
        "type": "object"
      },
      "Segment": {
        "additionalProperties": false,
        "properties": {
          "bpm": {
            "exclusiveMinimum": 0.0,
            "maximum": 2000.0,
            "title": "Bpm",
            "type": "number"
          },
          "meter": {
            "default": 4,
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Meter",
            "type": "integer"
          },
          "start_ms": {
            "description": "Red line time on the audio clock, ms",
            "title": "Start Ms",
            "type": "number"
          }
        },
        "required": [
          "start_ms",
          "bpm"
        ],
        "title": "Segment",
        "type": "object"
      },
      "Style": {
        "additionalProperties": false,
        "description": "Requested shares, 0 to 1. Anything left out comes from opening_chart_id, then from the planner.",
        "properties": {
          "chord": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chord"
          },
          "drag": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Phira only",
            "title": "Drag"
          },
          "flick": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Phira only",
            "title": "Flick"
          },
          "hold": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hold"
          }
        },
        "title": "Style",
        "type": "object"
      },
      "Timing": {
        "additionalProperties": false,
        "description": "Exactly one of: full segments, a BPM (the beat phase is found automatically), or an uploaded chart.",
        "properties": {
          "bpm": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 2000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bpm"
          },
          "chart_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chart Id"
          },
          "segments": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Segment"
                },
                "maxItems": 2000,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segments"
          }
        },
        "title": "Timing",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Draft rhythm game charts for an editor. Times are ms on the uploaded audio's clock.",
    "title": "NoteForge draft API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/audio": {
      "post": {
        "description": "Upload a song. The same file always gets the same `audio_id`, so its features are reused.",
        "operationId": "upload_audio_v1_audio_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_audio_v1_audio_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload Audio",
        "tags": [
          "inputs"
        ]
      }
    },
    "/v1/capabilities": {
      "get": {
        "description": "What a client can ask for, and the defaults.",
        "operationId": "capabilities_v1_capabilities_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Capabilities",
        "tags": [
          "service"
        ]
      }
    },
    "/v1/charts": {
      "post": {
        "description": "Upload a charter's chart (.osu for mania, RPE or official JSON or a package zip for Phira). Returns the timing and opening style found in it.",
        "operationId": "upload_chart_v1_charts_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_chart_v1_charts_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload Chart",
        "tags": [
          "inputs"
        ]
      }
    },
    "/v1/drafts": {
      "post": {
        "description": "Start a draft. Takes minutes; poll `GET /v1/drafts/{id}`. The same request returns the existing draft unless it failed or was cancelled.",
        "operationId": "create_draft_v1_drafts_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Draft",
        "tags": [
          "drafts"
        ]
      }
    },
    "/v1/drafts/{draft_id}": {
      "delete": {
        "description": "Cancel a queued or running draft. A finished draft is not changed.",
        "operationId": "cancel_draft_v1_drafts__draft_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
            "schema": {
              "title": "Draft Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Draft",
        "tags": [
          "drafts"
        ]
      },
      "get": {
        "operationId": "get_draft_v1_drafts__draft_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
            "schema": {
              "title": "Draft Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Draft",
        "tags": [
          "drafts"
        ]
      }
    },
    "/v1/drafts/{draft_id}/chart": {
      "get": {
        "description": "Download a playable chart file. `speed` is the Phira note speed.",
        "operationId": "get_chart_v1_drafts__draft_id__chart_get",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
            "schema": {
              "title": "Draft Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "revision",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Revision"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Format"
            }
          },
          {
            "in": "query",
            "name": "speed",
            "required": false,
            "schema": {
              "default": 10.0,
              "exclusiveMinimum": 0,
              "maximum": 100,
              "title": "Speed",
              "type": "number"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Chart",
        "tags": [
          "drafts"
        ]
      }
    },
    "/v1/drafts/{draft_id}/continue": {
      "post": {
        "description": "Keep the notes before `from_ms` exactly and write the rest as a new revision. Much faster than a new draft: the audio is not read again and only the remaining sections run.",
        "operationId": "continue_draft_v1_drafts__draft_id__continue_post",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
            "schema": {
              "title": "Draft Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContinueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
